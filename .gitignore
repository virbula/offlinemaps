# Generated PMTiles are GitHub Release assets, never Git commits.
*.pmtiles
*.pmtiles.part
*.pmtiles.previous
*.vtiles.tar
*.vtiles.tar.part
*.vtiles.tar.previous
*.osm.pbf
*.part

# Build scratch is ignored except for the immutable first-release takeover
# manifest whose SHA-256 is checked by the workflow.
build/*
!build/expected/
!build/expected/**

.dart_tool/
*.tmp
.DS_Store

# Compiled Python bytecode. Rewritten whenever a tool runs, so tracking
# it turns every build into a spurious diff.
__pycache__/
*.pyc
